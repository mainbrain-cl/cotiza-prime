# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.

# Entorno de la aplicación: "test" muestra la franja PRUEBAS; "production" no.
NEXT_PUBLIC_APP_ENV=test

# Supabase (los valores locales salen de `npx supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Cifrado de datos personales y huellas de búsqueda (modelo-datos.md §5). Solo servidor.
# Cada entorno tiene sus propias claves. Si se pierde CP_PII_KEY_V1, los datos no se recuperan.
# Generar cada clave de 32 bytes en base64 con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Versión con la que se cifra lo nuevo
CP_PII_KEY_CURRENT=v1
# Clave de cifrado (32 bytes, base64)
CP_PII_KEY_V1=
# Clave de huellas (32 bytes, base64; distinta de la anterior)
CP_SEARCH_KEY_V1=

# Dirección pública de la aplicación, para los enlaces de los correos (sin barra final).
# Local: http://localhost:3000. En producción es obligatoria.
APP_ORIGIN=http://localhost:3000

# Correo (decisión 016). Proveedor: mailpit (desarrollo local), memory (pruebas) o resend.
# En producción la aplicación NO arranca con mailpit o memory.
EMAIL_PROVIDER=mailpit
# Dirección desde la que salen los correos (el nombre visible es el de cada organización)
EMAIL_FROM_ADDRESS=cotizaciones@ejemplo.test
# Solo con EMAIL_PROVIDER=mailpit (Mailpit local de Docker)
MAILPIT_API_URL=http://127.0.0.1:56324
# Solo con EMAIL_PROVIDER=resend. Solo servidor; nunca en el repositorio.
RESEND_API_KEY=
# Secreto con que el proveedor firma los avisos de entrega y rebote. Solo servidor.
EMAIL_WEBHOOK_SECRET=
# Fuera de producción, solo se envía a estos dominios (separados por coma). Por defecto:
# ejemplo.test y rebota.ejemplo.test (este último simula rebotes). En producción no se usa.
EMAIL_ALLOWED_RECIPIENT_DOMAINS=ejemplo.test,rebota.ejemplo.test
