# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.

# Entorno de la aplicación: "test" muestra la franja PRUEBAS; "production" no.
NEXT_PUBLIC_APP_ENV=test

# Supabase (los valores locales salen de `npx supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Cifrado de datos personales y huellas de búsqueda (modelo-datos.md §5). Solo servidor.
# Cada entorno tiene sus propias claves. Si se pierde CP_PII_KEY_V1, los datos no se recuperan.
# Generar cada clave de 32 bytes en base64 con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Versión con la que se cifra lo nuevo
CP_PII_KEY_CURRENT=v1
# Clave de cifrado (32 bytes, base64)
CP_PII_KEY_V1=
# Clave de huellas (32 bytes, base64; distinta de la anterior)
CP_SEARCH_KEY_V1=
